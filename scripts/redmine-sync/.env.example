# Copiá a .env y completá. Este archivo nunca se commitea (ver .gitignore).

# Ruta al JSON de la cuenta de servicio del Admin SDK — se descarga en
# Firebase console → ⚙️ Configuración del proyecto → Cuentas de servicio →
# "Generar nueva clave privada". Guardalo FUERA del repo (ej: tu carpeta de
# usuario) y poné acá la ruta completa.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\tu_usuario\ticbr-service-account.json

# Datos de conexión a la base de Redmine (MariaDB).
REDMINE_DB_HOST=redminetic.bristol.com.py
REDMINE_DB_PORT=3306
REDMINE_DB_NAME=bitnami_redmine
REDMINE_DB_USER=vbarreto
REDMINE_DB_PASSWORD=
